# Copy this file to .env and fill it in. Never commit .env.

# --- Solana access -----------------------------------------------------
# A Helius (or other paid) RPC url is strongly recommended: the public
# endpoint is rate limited and rejects the holder-snapshot call.
# Example: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_URL=https://api.mainnet-beta.solana.com

# --- Your coin ---------------------------------------------------------
# Mint address of the FirstTX coin. Until this is set, the $25 holding
# requirement is skipped and every registration is marked unverified.
COIN_MINT=

# --- Competition settings ---------------------------------------------
MIN_HOLD_USD=25
# The cap is not enforced automatically — it is checked by hand at the end of
# the round, along with everything else about the top wallets.
DEPOSIT_CAP_USD=1000
# Funding split across several transactions within this many seconds counts as
# one opening deposit. Anything later is flagged for review.
DEPOSIT_GRACE_SECONDS=900

# --- Server ------------------------------------------------------------
PORT=8787
# Comma separated list of sites allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,https://firsttx.netlify.app
# Long random string. Required for every /api/admin/* call.
ADMIN_TOKEN=change-me-to-a-long-random-string

# --- Indexer -----------------------------------------------------------
# How often wallets are checked for new trades, in seconds.
INDEX_INTERVAL_SECONDS=60
# A quiet wallet (no new trades) is still re-priced this often, in seconds.
REVALUE_INTERVAL_SECONDS=300
