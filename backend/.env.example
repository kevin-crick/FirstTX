# Copy this file to .env and fill it in. Never commit .env.

# --- Solana access -----------------------------------------------------
# A Helius (or other paid) RPC url is strongly recommended: the public
# endpoint is rate limited and rejects the holder-snapshot call.
# Example: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_URL=https://api.mainnet-beta.solana.com

# --- Your coin ---------------------------------------------------------
# Mint address of the FirstTX coin. Until this is set, the $25 holding
# requirement is skipped and every registration is marked unverified.
COIN_MINT=

# --- Competition settings ---------------------------------------------
MIN_HOLD_USD=25
DEPOSIT_CAP_USD=1000
# Hour (UTC) the round starts. 0 = midnight.
ROUND_START_HOUR=0
# Hours the deposit window stays open after the start.
DEPOSIT_WINDOW_HOURS=1
# Hours before the round starts that registration opens (and the holder
# snapshot is taken). 12 = midday the day before.
REGISTRATION_LEAD_HOURS=12

# --- Server ------------------------------------------------------------
PORT=8787
# Comma separated list of sites allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,https://firsttx.netlify.app
# Long random string. Required for every /api/admin/* call.
ADMIN_TOKEN=change-me-to-a-long-random-string

# --- Indexer -----------------------------------------------------------
# How often wallets are re-scored, in seconds.
INDEX_INTERVAL_SECONDS=300
